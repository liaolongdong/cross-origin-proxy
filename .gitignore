# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
.output/
dist/
build/

# WXT cache and temporary files
.wxt/
.wxt-cache/

# TypeScript build info
*.tsbuildinfo

# Environment variables
# `.env.submit` 由 `pnpm exec wxt submit init` 生成，内含商店 OAuth 的 refresh token，
# 明文入库等于把发布权限交给任何能读这个仓库的人。宽泛排除 `.env*` 而不是逐个列举。
.env
.env.*

# IDE and Editor files
*.swp
*.swo
*~

# ESLint cache
.eslintcache
node_modules/.cache/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Chrome extension specific
*.crx
*.pem
*.zip

# Temporary files
*.tmp
*.temp

# 本地端到端验证产物（含下载的 Chrome for Testing，约 558MB，曾因误提交把 .git 撑到 195MB）
.test-tmp/

# 商店素材生成结果（由 `pnpm assets` 从 screenshots/ 派生，不入库；docs/assets/img 需入库供 Pages 使用）
store-assets/

# 仓库维护产物：历史改写备份、推广文案稿（仅本地）
*.bundle
.git-backup/
marketing/

# 会话临时产物
*.canvas.tsx

# 仅本地留证的 QA 截图（已从仓库解除跟踪，防止 git add -A 重新带回）
screenshots/dark-mode-issues.png

# 早期脚本产物（无语言后缀、已无任何引用，现由 og-image-zh/en.png 取代）
docs/assets/og-image.png
