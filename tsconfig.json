{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["chrome", "wxt"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [".wxt/wxt.d.ts", ".wxt/auto-imports.d.ts", "**/*.ts", "**/*.vue"],
  "exclude": ["wxt.config.ts", "vitest.config.ts", "node_modules", ".output"]
}
