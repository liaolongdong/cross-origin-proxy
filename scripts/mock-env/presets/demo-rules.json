        "createdAt": 1791849600000,
        "updatedAt": 1791849600000,
        "matchPattern": "http://localhost:5302/api/v1/data",
        "targetUrl": "http://localhost:5301/api/v1/data",
        "mockResponse": {
          "contentType": "application/json; charset=utf-8",
          "status": 200,
          "body": "{\"mock\":\"default\",\"env\":\"mock\",\"user\":{\"id\":42,\"name\":\"演示用户\",\"roles\":[\"admin\"]}}",
          "conditions": [
            {
              "matchQuery": {
                "p": "1"
              },
              "contentType": "application/json; charset=utf-8",
              "status": 201,
              "body": "{\"mock\":\"condition-p1\",\"env\":\"mock\",\"note\":\"这一份来自规则的条件分支，不是任何后端\"}"
            }
          ]
        }
